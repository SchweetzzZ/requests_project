# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=requests_db
POSTGRES_PORT=5432

# Backend Configuration
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/requests_db
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key
RUN_MIGRATIONS=true

# Usuários de demonstração (criados no primeiro start se ainda não existirem;
# deixe em branco para não criar). Nomes separados por vírgula, mesma senha para todos.
DEMO_USERS=usuario1,usuario2
DEMO_PASSWORD=Senha123!

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3000
